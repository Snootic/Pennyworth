<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(OS)' != 'Unix'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' == 'Unix'">Exe</OutputType>
    <AssemblyName>Pennyworth</AssemblyName>
    <RootNamespace>Pennyworth.App</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="'$(OS)' != 'Unix'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(OS)' != 'Unix'">Assets\pennyworth.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Avalonia's native Wayland backend is opt-in and Linux-only, so it is referenced (and compiled in through WAYLAND) only when the target is not Windows.
         The runtime identifier decides when there is one; without one, the build host does. -->
    <TargetsLinux Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('linux'))</TargetsLinux>
    <TargetsLinux Condition="'$(RuntimeIdentifier)' == ''">$([System.String]::Equals('$(OS)', 'Unix'))</TargetsLinux>
    <DefineConstants Condition="'$(TargetsLinux)' == 'true'">$(DefineConstants);WAYLAND</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pennyworth.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Avalonia.Wayland" Condition="'$(TargetsLinux)' == 'true'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Its build targets copy DirectML.dll, which the local assistant model needs on graphics cards; they do not flow through project references.
         DirectML is Windows-only: a Linux publish (and a Linux dev build) must not ship DirectML.dll, so it is referenced for Windows targets only.
         The runtime identifier decides when there is one (a win-x64 publish started from Linux still gets it); without one, the build host does. -->
    <PackageReference Include="Microsoft.AI.DirectML" Condition="('$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pennyworth.Core\Pennyworth.Core.csproj" />
    <ProjectReference Include="..\Pennyworth.Platform\Pennyworth.Platform.csproj" />
    <ProjectReference Include="..\Pennyworth.Platform.Linux\Pennyworth.Platform.Linux.csproj" />
    <ProjectReference Include="..\Pennyworth.Insights\Pennyworth.Insights.csproj" />
    <ProjectReference Include="..\Pennyworth.Scanning\Pennyworth.Scanning.csproj" />
    <ProjectReference Include="..\Pennyworth.Monitoring\Pennyworth.Monitoring.csproj" />
    <ProjectReference Include="..\Pennyworth.Cleanup\Pennyworth.Cleanup.csproj" />
    <ProjectReference Include="..\Pennyworth.Assistant\Pennyworth.Assistant.csproj" />
    <ProjectReference Include="..\Pennyworth.Assistant.Providers\Pennyworth.Assistant.Providers.csproj" />
    <ProjectReference Include="..\Pennyworth.Assistant.Local\Pennyworth.Assistant.Local.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window icon and the transparent logo shown in the title bar. -->
    <AvaloniaResource Include="Assets\pennyworth.ico" />
    <AvaloniaResource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golos Text and JetBrains Mono (SIL OFL 1.1); the licences ship next to the app. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\*-OFL.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Pennyworth.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
