<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pennyworth.App.ViewModels"
             xmlns:l="using:Pennyworth.App.Localization"
             x:Class="Pennyworth.App.Views.FolderBrowserView"
             x:DataType="vm:FolderBrowserViewModel">
  <UserControl.Styles>
    <!-- Rows are 44 px with a hairline above; a long list stays virtualized. -->
    <Style Selector="ListBox.folders ListBoxItem">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="{StaticResource Height.Row}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ListBox.folders ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.folders ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>

    <!-- The name opens folders and drives; for files it is plain text. -->
    <Style Selector="Button.name">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Base}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="Button.name:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.name:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.crumb">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.crumb.last">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.column">
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Grid.IsSharedSizeScope="True">
    <StackPanel Margin="36,28,36,14" Spacing="12">
      <TextBlock Classes="label">
        <Run Text="05 / " />
        <Run Text="{l:Tr NavFolders, Upper=True}" />
      </TextBlock>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,4" Text="{Binding SummaryText}" />
      </Grid>
      <TextBlock Classes="secondary" FontSize="13" Text="{l:Tr FoldersHelp}" />

      <!-- Toolbar: Back, Up and breadcrumbs. -->
      <Border Classes="group" Padding="4">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
          <Button Classes="ghost" Command="{Binding BackCommand}">
            <TextBlock>
              <Run Text="← " />
              <Run Text="{l:Tr Back, Upper=True}" />
            </TextBlock>
          </Button>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding UpCommand}">
            <TextBlock>
              <Run Text="↑ " />
              <Run Text="{l:Tr Up, Upper=True}" />
            </TextBlock>
          </Button>
          <Border Grid.Column="2" Width="1" Margin="0,2" Background="{DynamicResource Brush.BorderStrong}" />
          <ItemsControl Grid.Column="3" Margin="4,0,0,0" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BreadcrumbViewModel">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <TextBlock Classes="mono tertiary" Text="›" VerticalAlignment="Center" Margin="2,0" />
                  <Button Classes="link crumb" Classes.last="{Binding IsLast}" MaxWidth="220"
                          Command="{Binding $parent[UserControl].((vm:FolderBrowserViewModel)DataContext).NavigateToCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Column headers, aligned with the row grid below. -->
    <Grid Grid.Row="1" Margin="46,0,46,8" ColumnSpacing="14" IsVisible="{Binding HasItems}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="84" />
        <!-- Wide enough for the longest "Show in ..." label in either language; never narrower than before. -->
        <ColumnDefinition Width="Auto" MinWidth="156" SharedSizeGroup="ShowInFiles" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Classes="column" Text="{l:Tr ColumnName, Upper=True}" />
      <TextBlock Grid.Column="2" Classes="column" Text="{l:Tr ColumnShare, Upper=True}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Classes="column" TextAlignment="Right" Text="{l:Tr ColumnSize, Upper=True}" />
    </Grid>

    <Panel Grid.Row="2" Margin="36,0,36,24">
      <ListBox Classes="folders" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderItemViewModel">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="84" />
                <!-- Wide enough for the longest "Show in ..." label in either language; never narrower than before. -->
                <ColumnDefinition Width="Auto" MinWidth="156" SharedSizeGroup="ShowInFiles" />
              </Grid.ColumnDefinitions>
              <!-- Folder: filled tab and body. File: outlined sheet. Drive: outlined box with a light. -->
              <Panel Width="18" Height="15" VerticalAlignment="Center" IsVisible="{Binding IsFolder}">
                <Border Width="8" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Background="{DynamicResource Brush.TextSecondary}" />
                <Border Height="10" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource Brush.TextSecondary}" />
              </Panel>
              <Border Width="12" Height="15" VerticalAlignment="Center" BorderThickness="1.5"
                      BorderBrush="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding IsFile}" />
              <Border Width="18" Height="11" VerticalAlignment="Center" BorderThickness="1.5"
                      BorderBrush="{DynamicResource Brush.TextPrimary}" IsVisible="{Binding IsDrive}">
                <Border Width="2" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Background="{DynamicResource Brush.TextPrimary}" />
              </Border>

              <Button Grid.Column="1" Classes="name"
                      Command="{Binding $parent[UserControl].((vm:FolderBrowserViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding CanOpen}"
                      ToolTip.Tip="{Binding Name}">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" IsVisible="{Binding IsLocked}"
                          ToolTip.Tip="{l:Tr LockedHint}">
                    <TextBlock>
                      <Run Text="■ " />
                      <Run Text="{l:Tr Locked, Upper=True}" />
                    </TextBlock>
                  </Border>
                  <TextBlock Grid.Column="2" Classes="mono secondary" Text="›" VerticalAlignment="Center" IsVisible="{Binding CanOpen}" />
                </Grid>
              </Button>

              <ProgressBar Grid.Column="2" MinHeight="6" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" FontSize="13.5" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
              <Button Grid.Column="4" Classes="small" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Content="{l:Tr ShowInExplorer, Upper=True}"
                      Command="{Binding $parent[UserControl].((vm:FolderBrowserViewModel)DataContext).ShowInExplorerCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty folder -->
      <Border Classes="rule" Padding="0,60" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Panel Width="36" Height="26" Margin="0,0,0,8" HorizontalAlignment="Center">
            <Border Width="15" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1.5,1.5,1.5,0" BorderBrush="{DynamicResource Brush.TextSecondary}" />
            <Border Margin="0,6,0,0" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.TextSecondary}" />
          </Panel>
          <TextBlock FontSize="17" HorizontalAlignment="Center" Text="{l:Tr EmptyFolder}" />
          <TextBlock Classes="secondary" FontSize="13" HorizontalAlignment="Center" Text="{l:Tr EmptyFolderHint}" />
        </StackPanel>
      </Border>

      <!-- Locked folder -->
      <Border Classes="rule" Padding="0,56" IsVisible="{Binding IsLockedFolder}" VerticalAlignment="Top">
        <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
          <Border Classes="badge" HorizontalAlignment="Center" Padding="10,6">
            <TextBlock FontSize="13">
              <Run Text="■ " />
              <Run Text="{l:Tr Locked, Upper=True}" />
            </TextBlock>
          </Border>
          <TextBlock FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{l:Tr LockedTitle}" />
          <TextBlock Classes="secondary" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{l:Tr LockedBody}" />
          <Button HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10.5" Command="{Binding UnlockCommand}">
            <TextBlock>
              <Run Text="{l:Tr UnlockCta, Upper=True}" />
              <Run Text=" →" />
            </TextBlock>
          </Button>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
