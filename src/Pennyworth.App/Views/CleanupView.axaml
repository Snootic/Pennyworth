<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pennyworth.App.ViewModels"
             xmlns:l="using:Pennyworth.App.Localization"
             xmlns:controls="using:Pennyworth.App.Controls"
             x:Class="Pennyworth.App.Views.CleanupView"
             x:DataType="vm:CleanupViewModel">
  <UserControl.Styles>
    <!-- The check box from the design: a square that fills with ink and shows ✓. -->
    <Style Selector="Border.check">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.check.on">
      <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Border.check.unavailable">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Border.badge.think">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="TextBlock.glyph.think">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- What will be deleted: hairline rows, no selection highlight, virtualized for long lists. -->
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="Padding" Value="0,0,14,0" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>
    <!-- Same look as the Folders screen: names open folders, breadcrumbs, column headers. -->
    <Style Selector="Button.name">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Base}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="Button.name:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.name:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.crumb">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.crumb.last">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsPreviewing}">
      <StackPanel Margin="36,28,36,24" Spacing="18">
        <StackPanel Spacing="8">
          <TextBlock Classes="label">
            <Run Text="03 / " />
            <Run Text="{l:Tr NavCleanup, Upper=True}" />
          </TextBlock>
          <TextBlock Classes="title" TextWrapping="Wrap" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar Classes="sweep" IsVisible="{Binding IsMeasuring}" />

        <!-- Choose: grouped by safety, Safe items already ticked. -->
        <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding IsSelecting}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CleanupGroupViewModel">
              <StackPanel Margin="0,0,0,8">
                <WrapPanel Margin="0,12,0,8">
                  <Border Classes="badge" Classes.think="{Binding IsThinkFirst}" Padding="8,3" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="glyph" Classes.think="{Binding IsThinkFirst}" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Glyph}" />
                      <TextBlock Text="{Binding Label, Converter={x:Static controls:TextCase.Upper}}" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Hint}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupItemViewModel">
                      <StackPanel>
                      <Button Classes="row" Padding="10,14" IsEnabled="{Binding IsAvailable}"
                              Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).ToggleCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="20,*,90" ColumnSpacing="16">
                          <Border Classes="check" Classes.on="{Binding IsSelected}" Classes.unavailable="{Binding NeedsFullScan}">
                            <TextBlock Text="✓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Background}" IsVisible="{Binding IsSelected}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="15" Text="{Binding Title}" />
                            <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding Description}" />
                            <TextBlock FontSize="13" TextWrapping="Wrap">
                              <Run Text="{l:Tr IfRemoved, Upper=True}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                              <Run Text=" " />
                              <Run Text="{Binding Consequence}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap"
                                       Text="{l:Tr NeedsFullScan}" IsVisible="{Binding NeedsFullScan}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" FontSize="15" TextAlignment="Right" Text="{Binding SizeText}" />
                        </Grid>
                      </Button>
                      <!-- Outside the row so it works even for items that can't be cleaned yet. -->
                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="40,-10,0,10">
                        <Button Classes="link" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Accent}"
                                Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).OpenPreviewCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding PreviewText}" />
                            <TextBlock Text="→" />
                          </StackPanel>
                        </Button>
                        <Button Classes="small" Content="{l:Tr AskAboutThis, Upper=True}" VerticalAlignment="Center" IsVisible="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).CanAsk}"
                                Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).AskAboutItemCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cleaning: one item at a time, with text progress bars. -->
        <ItemsControl ItemsSource="{Binding RunItems}" IsVisible="{Binding IsCleaning}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CleanupItemViewModel">
              <Border Classes="rule" Padding="0,14">
                <Grid ColumnDefinitions="*,220,64" ColumnSpacing="18">
                  <TextBlock FontSize="15" VerticalAlignment="Center" Text="{Binding Title}" />
                  <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center" Text="{Binding ProgressBar}" />
                  <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding ProgressText}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Done: what was removed and what was left alone. -->
        <StackPanel Spacing="18" IsVisible="{Binding IsDone}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Classes="mono" Foreground="{DynamicResource Brush.Accent}" Text="■" />
            <TextBlock Grid.Column="1" Classes="secondary" TextWrapping="Wrap" Text="{Binding SkippedText}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding RunItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CleanupItemViewModel">
                <Border Classes="rule" Padding="0,11">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding FreedText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button MinHeight="40" Padding="18,0" Background="{DynamicResource Brush.TextPrimary}" Foreground="{DynamicResource Brush.Background}"
                    Content="{l:Tr Done, Upper=True}" Command="{Binding FinishCommand}" />
            <Button MinHeight="40" Padding="18,0" BorderBrush="{DynamicResource Brush.BorderStrong}"
                    Content="{l:Tr BackHome, Upper=True}" Command="{Binding BackHomeCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Nothing to clean. -->
        <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,40" IsVisible="{Binding IsEmpty}">
          <TextBlock Classes="mono secondary" FontSize="12" LineHeight="15" HorizontalAlignment="Center"
                     Text="+-----------+&#10;| 0000 0000 |&#10;| 0000 0000 |&#10;+-----------+" />
          <TextBlock FontSize="18" HorizontalAlignment="Center" Text="{l:Tr NothingTitle}" />
          <TextBlock Classes="secondary" FontSize="13" HorizontalAlignment="Center" Text="{l:Tr NothingSub}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- What will be deleted: one item's folders and every file, before anything is touched. -->
    <ContentControl Content="{Binding Preview}" IsVisible="{Binding IsPreviewing}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:CleanupPreviewViewModel">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="36,20,36,0" Grid.IsSharedSizeScope="True">
            <StackPanel Spacing="8">
              <Button Classes="ghost" HorizontalAlignment="Left" Margin="-10,0,0,4" Command="{Binding CloseCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="←" />
                  <TextBlock Text="{l:Tr PreviewBack, Upper=True}" />
                </StackPanel>
              </Button>
              <TextBlock Classes="label">
                <Run Text="03 / " />
                <Run Text="{l:Tr PreviewLabel, Upper=True}" />
              </TextBlock>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Classes="title" TextWrapping="Wrap" Text="{Binding Item.Title}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="small" Content="{l:Tr AskAboutThis, Upper=True}" IsVisible="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).CanAsk}"
                        Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).AskAboutItemCommand}" CommandParameter="{Binding Item}" />
                <Button Classes="small" VerticalAlignment="Center" IsEnabled="{Binding Item.IsAvailable}" Command="{Binding ToggleIncludeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="check" Classes.on="{Binding Item.IsSelected}" Width="14" Height="14" Margin="0" VerticalAlignment="Center">
                      <TextBlock Text="✓" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Background}" IsVisible="{Binding Item.IsSelected}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Text="{l:Tr PreviewInclude, Upper=True}" />
                  </StackPanel>
                </Button>
                </StackPanel>
              </Grid>
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Summary}" />
              <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="{l:Tr IfRemoved, Upper=True}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Run Text=" " />
                <Run Text="{Binding Item.Consequence}" />
              </TextBlock>
            </StackPanel>

            <!-- Toolbar like the Folders screen: Back, Up, breadcrumbs and Explorer. -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,18,0,0" IsVisible="{Binding CanNavigate}">
              <TextBlock Classes="label" Text="{l:Tr PreviewFolders, Upper=True}" />
              <Border Classes="group" Padding="4">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                  <Button Classes="ghost" Command="{Binding BackCommand}">
                    <TextBlock>
                      <Run Text="← " />
                      <Run Text="{l:Tr Back, Upper=True}" />
                    </TextBlock>
                  </Button>
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding UpCommand}">
                    <TextBlock>
                      <Run Text="↑ " />
                      <Run Text="{l:Tr Up, Upper=True}" />
                    </TextBlock>
                  </Button>
                  <Border Grid.Column="2" Width="1" Margin="0,2" Background="{DynamicResource Brush.BorderStrong}" />
                  <ItemsControl Grid.Column="3" Margin="4,0,0,0" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PreviewCrumb">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <TextBlock Classes="mono tertiary" Text="›" VerticalAlignment="Center" Margin="2,0" />
                          <Button Classes="link crumb" Classes.last="{Binding IsLast}" MaxWidth="260"
                                  Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).Preview.NavigateToCommand}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}" TextTrimming="LeadingCharacterEllipsis" />
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Grid.Column="4" Classes="small" VerticalAlignment="Center" Margin="8,0,4,0"
                          Content="{l:Tr PreviewShowFolder, Upper=True}" IsVisible="{Binding CanShowCurrent}"
                          Command="{Binding ShowCurrentInExplorerCommand}" />
                </Grid>
              </Border>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,240" ColumnSpacing="14" Margin="0,16,0,8">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="label" Text="{Binding ListLabel, Converter={x:Static controls:TextCase.Upper}}" />
                <TextBlock Classes="caption" Text="{Binding MatchText}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="search" PlaceholderText="{l:Tr PreviewSearch}" Text="{Binding Search}" />
            </Grid>

            <!-- Column headers, aligned with the rows below. -->
            <Grid Grid.Row="3" Margin="0,4,14,6" ColumnSpacing="14" IsVisible="{Binding !HasNoMatch}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="84" />
                <!-- Wide enough for the longest "Show in ..." label in either language; never narrower than before. -->
                <ColumnDefinition Width="Auto" MinWidth="156" SharedSizeGroup="ShowInFiles" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Classes="column" Text="{l:Tr ColumnName, Upper=True}" />
              <TextBlock Grid.Column="2" Classes="column" Text="{l:Tr ColumnShare, Upper=True}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Classes="column" TextAlignment="Right" Text="{l:Tr ColumnSize, Upper=True}" />
            </Grid>

            <Panel Grid.Row="4" Margin="0,0,0,12">
              <ListBox Classes="files" ItemsSource="{Binding Entries}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PreviewEntry">
                    <Grid ColumnSpacing="14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="84" />
                        <!-- Wide enough for the longest "Show in ..." label in either language; never narrower than before. -->
                        <ColumnDefinition Width="Auto" MinWidth="156" SharedSizeGroup="ShowInFiles" />
                      </Grid.ColumnDefinitions>
                      <!-- Folder: filled tab and body. File: outlined sheet. -->
                      <Panel Width="18" Height="15" VerticalAlignment="Center" IsVisible="{Binding IsFolder}">
                        <Border Width="8" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Background="{DynamicResource Brush.TextSecondary}" />
                        <Border Height="10" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource Brush.TextSecondary}" />
                      </Panel>
                      <Border Width="12" Height="15" VerticalAlignment="Center" BorderThickness="1.5"
                              BorderBrush="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding IsFile}" />

                      <Button Grid.Column="1" Classes="name" IsEnabled="{Binding IsFolder}" ToolTip.Tip="{Binding Path}"
                              Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).Preview.OpenCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Classes="tertiary" FontSize="11.5" TextTrimming="LeadingCharacterEllipsis"
                                       Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="mono secondary" Text="›" VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                        </Grid>
                      </Button>

                      <ProgressBar Grid.Column="2" MinHeight="6" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" FontSize="13.5" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SizeText}" />
                      <Button Grid.Column="4" Classes="small" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding CanShow}"
                              Content="{l:Tr ShowInExplorer, Upper=True}"
                              Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).Preview.ShowInExplorerCommand}"
                              CommandParameter="{Binding Path}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="secondary" Margin="0,20" HorizontalAlignment="Center" Text="{Binding NoMatchText}" IsVisible="{Binding HasNoMatch}" />
            </Panel>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- Sticky footer: running total and the Clean button. -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="36,14,36,18" IsVisible="{Binding IsSelecting}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="secondary" FontSize="13" Text="{Binding SelectedLine}" />
          <ProgressBar MinHeight="4" Height="4" Minimum="0" Maximum="1" Value="{Binding SelectedFraction}" Foreground="{DynamicResource Brush.Accent}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" MinHeight="44" Padding="20,0" FontSize="12" Command="{Binding AskCleanCommand}" IsEnabled="{Binding CanClean}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding CleanButtonText, Converter={x:Static controls:TextCase.Upper}}" />
            <TextBlock Text="→" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
