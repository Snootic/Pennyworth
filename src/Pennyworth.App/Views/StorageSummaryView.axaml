<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pennyworth.App.ViewModels"
             xmlns:l="using:Pennyworth.App.Localization"
             xmlns:controls="using:Pennyworth.App.Controls"
             x:Class="Pennyworth.App.Views.StorageSummaryView"
             x:DataType="vm:StorageSummaryViewModel">
  <UserControl.Styles>
    <!-- Drive switcher: a segmented control, the selected drive inverted. -->
    <Style Selector="ListBox.segmented">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Background}" />
    </Style>

    <!-- Category legend rows: hairline above each, selected swatch in the accent colour. -->
    <Style Selector="ListBox.legend ListBoxItem">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ListBox.legend ListBoxItem:selected controls|SegmentedBar">
      <Setter Property="IsHighlighted" Value="True" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Padding.Page}" Spacing="20">
      <!-- Header: title on the left, drive switcher and scan status on the right. Many mount points scroll instead of squeezing the title. -->
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="300" />
          <ColumnDefinition Width="Auto" MaxWidth="440" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">
          <TextBlock Classes="label">
            <Run Text="02 / " />
            <Run Text="{l:Tr NavStorage, Upper=True}" />
          </TextBlock>
          <TextBlock Classes="title" Text="{l:Tr StorageTitle}" TextWrapping="Wrap" />
          <TextBlock FontSize="15" Text="{Binding UsedText}" />
          <TextBlock Classes="secondary" FontSize="13.5" MaxWidth="520" HorizontalAlignment="Left" TextWrapping="Wrap"
                     Text="{l:Tr StorageHelp}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Bottom" HorizontalAlignment="Right">
          <ScrollViewer HorizontalAlignment="Right" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ListBox Classes="segmented" HorizontalAlignment="Right"
                     ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Drives}"
                     SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedDrive}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding UsedText}">
                    <TextBlock Classes="mono" Text="{Binding Token}" VerticalAlignment="Center" />
                    <TextBlock FontSize="13" Text="{Binding Caption}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Classes.blink="{Binding !IsComplete}"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Classes="label" LetterSpacing="0" FontSize="11" VerticalAlignment="Center"
                       Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StatusText}" />
            <Button Classes="link" FontFamily="{StaticResource FontFamily.Mono}" FontSize="11"
                    Content="{l:Tr Rescan}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RescanCommand}"
                    IsVisible="{Binding IsComplete}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- The hero bar: every category plus "not measured yet" fills exactly 100%. Click a block to select it. -->
      <StackPanel Spacing="8">
        <controls:SegmentedBar Name="Bar" Height="{StaticResource Height.StorageBar}" Gap="2" Cursor="Hand"
                               Segments="{Binding Segments}"
                               HighlightKey="{Binding SelectedColorKey}"
                               TrackBrush="{DynamicResource Brush.Track}" />
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontFamily" Value="{StaticResource FontFamily.Mono}" />
              <Setter Property="FontSize" Value="10" />
              <Setter Property="LetterSpacing" Value="0.6" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            </Style>
          </Grid.Styles>
          <TextBlock Text="0%" />
          <TextBlock Grid.Column="2" Text="25%" />
          <TextBlock Grid.Column="4" Text="50%" />
          <TextBlock Grid.Column="6" Text="75%" />
          <TextBlock Grid.Column="8" Text="{Binding FreeText, StringFormat='100% · {0}'}" />
        </Grid>
      </StackPanel>

      <Border Classes="card" Padding="16,12" IsVisible="{Binding HasOvercount}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="mono" Text="i" />
          <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{l:Tr OvercountHint}" />
        </Grid>
      </Border>

      <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="16,12" IsVisible="{Binding ShowUnlockBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Classes="mono secondary" Text="[ ]" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr UnlockBanner}" />
          <Button Grid.Column="2" MinHeight="30" Padding="12,0" FontSize="10.5" Command="{Binding UnlockCommand}">
            <TextBlock>
              <Run Text="{l:Tr UnlockCta, Upper=True}" />
              <Run Text=" →" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>

      <!-- Linux, second step: snapshots and file system bookkeeping that only an administrator can measure. -->
      <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="16,12" IsVisible="{Binding ShowAdminSpaceBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Classes="mono secondary" Text="[■]" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr AdminSpaceBanner}" />
          <Button Grid.Column="2" MinHeight="30" Padding="12,0" FontSize="10.5" Command="{Binding IncludeAdminSpaceCommand}">
            <TextBlock>
              <Run Text="{l:Tr AdminSpaceCta, Upper=True}" />
              <Run Text=" →" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <Border Classes="card" Padding="16,12" IsVisible="{Binding ShowAdminSpaceReason}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="mono" Text="i" />
          <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding AdminSpaceReasonText}" />
        </Grid>
      </Border>

      <!-- Linux: folders the scan could not list, measured on request. -->
      <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="16,12" IsVisible="{Binding ShowLockedBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Classes="mono secondary" Text="[■]" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding LockedBannerText}" />
          <Button Grid.Column="2" MinHeight="30" Padding="12,0" FontSize="10.5" Command="{Binding MeasureLockedCommand}">
            <TextBlock>
              <Run Text="{l:Tr LockedMeasureCta, Upper=True}" />
              <Run Text=" →" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <Border Classes="card" Padding="16,12" IsVisible="{Binding ShowLockedReason}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="mono" Text="i" />
          <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding LockedReasonText}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="32">
        <!-- Category legend -->
        <StackPanel>
          <TextBlock Classes="label" Margin="0,0,0,10" Text="{l:Tr Categories, Upper=True}" />
          <ListBox Classes="legend" ItemsSource="{Binding Legend}" SelectedItem="{Binding SelectedCategory}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryRowViewModel">
                <Grid ColumnDefinitions="34,*,58,74,12" ColumnSpacing="12">
                  <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Height="16" VerticalAlignment="Center">
                    <controls:SegmentedBar Segments="{Binding Swatch}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="caption" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="label" LetterSpacing="0" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PercentText}" />
                  <TextBlock Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SizeText}" />
                  <TextBlock Grid.Column="4" Classes="mono secondary" VerticalAlignment="Center" Text="›" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Classes="rule" Padding="0,14,0,0">
            <Button HorizontalAlignment="Left" Command="{Binding BrowseAllCommand}">
              <TextBlock>
                <Run Text="{l:Tr BrowseAllFolders, Upper=True}" />
                <Run Text=" →" />
              </TextBlock>
            </Button>
          </Border>
        </StackPanel>

        <!-- Biggest places of the selected category -->
        <StackPanel Grid.Column="1">
          <TextBlock Classes="label" Margin="0,0,0,10" Text="{Binding PlacesTitle, Converter={x:Static controls:TextCase.Upper}}" />
          <Border Classes="rule" Padding="0,22" IsVisible="{Binding ShowPlacesPending}">
            <StackPanel Spacing="14">
              <ProgressBar Classes="sweep" />
              <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{l:Tr BiggestPlacesPending}" />
            </StackPanel>
          </Border>
          <Border Classes="rule" Padding="0,18" IsVisible="{Binding ShowUnaccountedExplanation}">
            <StackPanel Spacing="14">
              <TextBlock LineHeight="21" TextWrapping="Wrap" Text="{l:Tr UnaccountedHint}" IsVisible="{Binding !IsUnlocked}" />
              <TextBlock LineHeight="21" TextWrapping="Wrap" Text="{Binding Unaccounted.Hint}" IsVisible="{Binding IsUnlocked}" />
              <Button HorizontalAlignment="Left" MinHeight="32" Padding="12,0" FontSize="10.5" Command="{Binding UnlockCommand}" IsVisible="{Binding ShowUnlockBanner}">
                <TextBlock>
                  <Run Text="{l:Tr UnlockCta, Upper=True}" />
                  <Run Text=" →" />
                </TextBlock>
              </Button>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding SelectedCategory.Areas}" IsVisible="{Binding ShowPlaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryAreaViewModel">
                <Button Classes="row" Padding="8,12" IsEnabled="{Binding CanOpen}"
                        Command="{Binding $parent[UserControl].((vm:StorageSummaryViewModel)DataContext).OpenAreaCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SizeText}" />
                        <TextBlock Classes="mono secondary" Width="8" Text="›" IsVisible="{Binding CanOpen}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}"
                               IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid ColumnDefinitions="*,84" ColumnSpacing="10">
                      <TextBlock Classes="label" LetterSpacing="0" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ClipToBounds="True" />
                      <ProgressBar Grid.Column="1" MinHeight="4" Height="4" Minimum="0" Maximum="1" Value="{Binding Share}" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
