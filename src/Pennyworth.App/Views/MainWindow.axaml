<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pennyworth.App.ViewModels"
        xmlns:l="using:Pennyworth.App.Localization"
        xmlns:controls="using:Pennyworth.App.Controls"
        x:Class="Pennyworth.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pennyworth"
        Icon="/Assets/pennyworth.ico"
        Width="1100" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="{Binding ExtendsIntoTitleBar}"
        Classes.extended="{Binding ExtendsIntoTitleBar}">
  <Window.Styles>
    <!-- Sidebar entries: index, label and a one-line hint. -->
    <Style Selector="Button.nav">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Base}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.nav TextBlock.index">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.nav.selected TextBlock.index">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.dot">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.dot.active">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Mono}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Windows draws its caption buttons over the right 148 px of the title bar row. -->
    <Style Selector="Window.extended Grid#TitleBarContent">
      <Setter Property="Margin" Value="0,0,148,0" />
    </Style>

    <!-- At narrow widths the content gets the whole window. -->
    <Style Selector="Window.narrow Border#Sidebar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- "May I see the rest of the drive?" -->
    <DataTemplate DataType="vm:UnlockDialogViewModel">
      <StackPanel Spacing="18">
        <StackPanel Spacing="18" IsVisible="{Binding IsAsking}">
          <TextBlock Classes="label" Foreground="{DynamicResource Brush.Accent}" Text="[ ] → [■]" />
          <TextBlock FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Text="{l:Tr UnlockTitle}" />
          <TextBlock Classes="secondary" LineHeight="21" TextWrapping="Wrap" Text="{l:Tr UnlockWhy}" />
          <Border Background="{DynamicResource Brush.Border}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="1">
              <StackPanel Background="{DynamicResource Brush.Surface}" Spacing="6" Margin="0">
                <TextBlock Classes="label" Margin="14,14,14,0" Text="{l:Tr CanSee, Upper=True}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="14,0,14,14" Text="{l:Tr SeeList}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Background="{DynamicResource Brush.Surface}" Spacing="6">
                <TextBlock Classes="label" Margin="14,14,14,0" Text="{l:Tr Wont, Upper=True}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="14,0,14,14" Text="{l:Tr WontList}" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Spacing="10" IsVisible="{Binding IsWaiting}">
            <ProgressBar Classes="sweep" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Classes="label" LetterSpacing="0" FontSize="11" Text="{l:Tr Waiting}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr NotNow, Upper=True}" Command="{Binding NotNowCommand}" />
            <Button Classes="primary" MinHeight="40" Padding="18,0" Content="{l:Tr Unlock, Upper=True}" Command="{Binding UnlockCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="18" IsVisible="{Binding IsDeclined}">
          <TextBlock FontSize="24" FontWeight="Medium" Text="{l:Tr DeclinedTitle}" />
          <TextBlock Classes="secondary" LineHeight="21" TextWrapping="Wrap" Text="{l:Tr DeclinedSub}" />
          <Button HorizontalAlignment="Right" MinHeight="40" Padding="20,0" Background="{DynamicResource Brush.TextPrimary}"
                  Foreground="{DynamicResource Brush.Background}" Content="{l:Tr Ok}" Command="{Binding CloseCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- A read-only request that needs an administrator's password: what it reads, what it leaves alone, then the wait. -->
    <DataTemplate DataType="vm:PrivilegedDialogViewModel">
      <StackPanel Spacing="18">
        <StackPanel Spacing="18" IsVisible="{Binding IsAsking}">
          <TextBlock Classes="label" Foreground="{DynamicResource Brush.Accent}" Text="[ ] → [■]" />
          <TextBlock FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Title}" />
          <TextBlock Classes="secondary" LineHeight="21" TextWrapping="Wrap" Text="{Binding Why}" />
          <Border Background="{DynamicResource Brush.Border}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="1">
              <StackPanel Background="{DynamicResource Brush.Surface}" Spacing="6" Margin="0">
                <TextBlock Classes="label" Margin="14,14,14,0" Text="{l:Tr CanSee, Upper=True}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="14,0,14,14" Text="{Binding Reads}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Background="{DynamicResource Brush.Surface}" Spacing="6">
                <TextBlock Classes="label" Margin="14,14,14,0" Text="{l:Tr Wont, Upper=True}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="14,0,14,14" Text="{Binding Wont}" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Spacing="10" IsVisible="{Binding IsWaiting}">
            <ProgressBar Classes="sweep" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Classes="label" LetterSpacing="0" FontSize="11" Text="{l:Tr PrivWaiting}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" IsVisible="{Binding IsIdle}">
            <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr NotNow, Upper=True}" Command="{Binding NotNowCommand}" />
            <Button Classes="primary" MinHeight="40" Padding="18,0" Content="{l:Tr PrivAsk, Upper=True}" Command="{Binding StartCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="18" IsVisible="{Binding IsMessage}">
          <TextBlock FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Title}" />
          <TextBlock Classes="secondary" LineHeight="21" TextWrapping="Wrap" Text="{Binding Message}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr PrivTryAgain, Upper=True}" Command="{Binding TryAgainCommand}" />
            <Button MinHeight="40" Padding="20,0" Background="{DynamicResource Brush.TextPrimary}"
                    Foreground="{DynamicResource Brush.Background}" Content="{l:Tr Ok}" Command="{Binding CloseCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- "Clean 18.2 GB?" -->
    <DataTemplate DataType="vm:CleanConfirmDialogViewModel">
      <StackPanel Spacing="18">
        <TextBlock FontSize="24" FontWeight="Medium" Text="{Binding Title}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{l:Tr ConfirmSub}" />
        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CleanupItemViewModel">
                <Border Classes="rule" Padding="0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="1">
                      <TextBlock FontSize="13.5" Text="{Binding Title}" />
                      <TextBlock Classes="caption" Text="{Binding CountText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="secondary" FontSize="13.5" VerticalAlignment="Center" Text="{Binding SizeText}" />
                    <Button Grid.Column="2" Classes="small" VerticalAlignment="Center" Content="{l:Tr ConfirmReview, Upper=True}"
                            Command="{Binding $parent[ItemsControl].((vm:CleanConfirmDialogViewModel)DataContext).ReviewCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Spacing="6">
          <TextBlock FontSize="13" Text="{Binding CountLine}" />
          <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{l:Tr ConfirmOnlyListed}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="14,12" IsVisible="{Binding ShowBinNote}">
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding BinNote}" />
        </Border>
        <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="14,12" IsVisible="{Binding ShowPasswordNote}">
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding PasswordNote}" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr Cancel, Upper=True}" Command="{Binding CancelCommand}" />
          <Button Classes="primary" MinHeight="40" Padding="18,0" Content="{l:Tr ConfirmClean, Upper=True}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- "What I'm about to send": the exact text of a cloud request, before it leaves the PC. -->
    <DataTemplate DataType="vm:SendPreviewDialogViewModel">
      <StackPanel Spacing="14">
        <TextBlock FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Text="{l:Tr SendPreviewTitle}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Subtitle}" />
        <TextBlock Classes="label" Text="{l:Tr SendPreviewQuestion, Upper=True}" />
        <SelectableTextBlock FontSize="13.5" TextWrapping="Wrap" Text="{Binding Question}" />
        <TextBlock Classes="label" Text="{l:Tr SendPreviewInstructions, Upper=True}" />
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" MaxHeight="260">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock Classes="mono" FontSize="11" LineHeight="15" Margin="10,8" TextWrapping="Wrap" Text="{Binding Instructions}" />
          </ScrollViewer>
        </Border>
        <CheckBox IsChecked="{Binding DontShowAgain}" Content="{l:Tr DontShowAgain}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr EditQuestion, Upper=True}" Command="{Binding CancelCommand}" />
          <Button Classes="primary" MinHeight="40" Padding="18,0" Content="{l:Tr Send, Upper=True}" Command="{Binding SendCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- "Close Google Chrome?" and, if it refuses, "Force close". -->
    <DataTemplate DataType="vm:CloseAppDialogViewModel">
      <StackPanel Spacing="18">
        <TextBlock FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Subtitle}" />
        <ProgressBar Classes="sweep" IsVisible="{Binding IsClosing}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="40" Content="{l:Tr Cancel, Upper=True}" Command="{Binding CancelCommand}" />
          <Button MinHeight="40" Padding="18,0" Background="{DynamicResource Brush.TextPrimary}" Foreground="{DynamicResource Brush.Background}"
                  Content="{l:Tr CloseApp, Upper=True}" Command="{Binding CloseCommand}" IsVisible="{Binding IsAsking}" />
          <Button Classes="primary" MinHeight="40" Padding="18,0" Content="{l:Tr ForceClose, Upper=True}"
                  Command="{Binding ForceCloseCommand}" IsVisible="{Binding IsRefused}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="44,*,28">
    <!--
      Title bar. Only the left part (logo and empty space) is the drag area: buttons inside a
      TitleBar element don't reliably get clicks on Windows, so they sit beside it, not in it.
      Where the window draws into the title bar, the system's caption buttons are drawn over the right 148 px.
    -->
    <Border Classes="rule" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Background}">
      <Grid x:Name="TitleBarContent" ColumnDefinitions="*,Auto">
        <Border Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
            <Image Source="/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="PENNYWORTH" FontWeight="SemiBold" FontSize="12" LetterSpacing="2.4" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Classes="group" ToolTip.Tip="{l:Tr ModeTip}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Classes.selected="{Binding !Is3d}" Content="{l:Tr ModeSimple, Upper=True}" Command="{Binding SetSimpleModeCommand}" />
              <Border Width="1" Background="{DynamicResource Brush.BorderStrong}" />
              <Button Classes="segment" Classes.selected="{Binding Is3d}" Content="{l:Tr Mode3d, Upper=True}" Command="{Binding Set3dModeCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Padding="10,0" Classes.selected="{Binding IsPortuguese}" Content="PT" Command="{Binding SetPortugueseCommand}" />
              <Border Width="1" Background="{DynamicResource Brush.BorderStrong}" />
              <Button Classes="segment" Padding="10,0" Classes.selected="{Binding IsEnglish}" Content="EN" Command="{Binding SetEnglishCommand}" />
            </StackPanel>
          </Border>
          <Button BorderBrush="{DynamicResource Brush.BorderStrong}" MinHeight="28" Padding="12,0"
                  Foreground="{DynamicResource Brush.TextSecondary}" Command="{Binding ToggleThemeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="◐" />
              <TextBlock Text="{Binding ThemeLabel, Converter={x:Static controls:TextCase.Upper}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Panel IsVisible="{Binding ShowSidebar}">
        <Border Name="Sidebar" Width="{StaticResource Width.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,18,0,16">
            <StackPanel>
              <Button Classes="nav" Classes.selected="{Binding IsHomePage}" Command="{Binding GoHomeCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="01" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavHome}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavHomeHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsStoragePage}" Command="{Binding ShowStorageCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="02" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavStorage}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavStorageHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsCleanupPage}" Command="{Binding GoCleanupCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="03" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavCleanup}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavCleanupHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsMemoryPage}" Command="{Binding GoMemoryCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="04" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavMemory}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavMemoryHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsFoldersPage}" Command="{Binding ShowFoldersCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="05" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavFolders}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavFoldersHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsSpecsPage}" Command="{Binding GoSpecsCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="06" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavSpecs}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavSpecsHint}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="nav" Classes.selected="{Binding IsAskPage}" Command="{Binding GoAskCommand}" IsVisible="{Binding HasAssistant}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="6">
                  <TextBlock Classes="label index" Text="07" Margin="0,3,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{l:Tr NavAsk}" />
                    <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr NavAskHint}" />
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Classes="mono tertiary" FontSize="10" LineHeight="12" Margin="18,0,18,12" Text="{Binding ChipArt}" />
            <TextBlock Grid.Row="3" Classes="label" LetterSpacing="0.8" FontSize="10" Margin="18,0" Text="{l:Tr Version}" />
          </Grid>
        </Border>
      </Panel>

      <ContentControl Grid.Column="1" Content="{Binding MainContent}" />
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Classes="rule">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="dot" Classes.active="{Binding IsScanning}" Classes.blink="{Binding IsScanning}" Text="●" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Classes="status" Text="{Binding StatusShort}" />
          </StackPanel>
          <TextBlock Classes="status" Text="{Binding SystemDriveStatus}" />
          <TextBlock Classes="status" Text="{Binding RamStatus}" />
          <TextBlock Classes="status" Text="{Binding CpuStatus}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="status" Foreground="{DynamicResource Brush.TextTertiary}" LetterSpacing="1.4" Text="{Binding BitsLine}" />
      </Grid>
    </Border>

    <!-- Dialogs dim everything behind them. -->
    <Border Grid.RowSpan="3" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding HasDialog}">
      <Border Width="500" MaxWidth="{Binding $parent[Window].Bounds.Width}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
              Padding="28" BoxShadow="{StaticResource Shadow.Dialog}" Margin="24">
        <ContentControl Content="{Binding Dialog}" />
      </Border>
    </Border>

    <!-- Toast: short confirmations, bottom right. -->
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,20,16" MaxWidth="420"
            Background="{DynamicResource Brush.TextPrimary}" Padding="16,12" IsVisible="{Binding HasToast}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock Classes="mono" Foreground="{DynamicResource Brush.Background}" Text="■" />
        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Background}" Text="{Binding Toast}" />
      </Grid>
    </Border>
  </Grid>
</Window>
